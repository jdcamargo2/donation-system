# Example environment for SIGEDON scheduled backup / restore drill.
# Platform-owned: copy and adapt; scripts do NOT read this file automatically.
# Prefer ~/.pgpass (mode 0600) over PGPASSWORD. No production secrets here.

# --- Shared ---
# SIGEDON_BACKUP_ROOT=/var/backups/sigedon
# SIGEDON_MEDIA_ROOT=/var/lib/sigedon/media
# POSTGRES_DB=sigedon
# POSTGRES_USER=sigedon_owner
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# PGPASSWORD=

# --- Scheduled backup pipeline (run_scheduled_backup.sh) ---
# Operator/platform must quiesce writers before exporting this:
# SIGEDON_MAINTENANCE_CONFIRMED=YES
# SIGEDON_BACKUP_KEEP_COUNT=7
# SIGEDON_BACKUP_KEEP_DAYS=30
# SIGEDON_BACKUP_ALERT_HOOK=/usr/local/sbin/sigedon-backup-alert.sh
# SIGEDON_BACKUP_ALERT_HOOK_TIMEOUT_SECONDS=30
# SIGEDON_BACKUP_ALERT_ON_SUCCESS=NO

# --- Restore drill only (run_restore_drill.sh) ---
# Never point these at production. Timer must not call restore_sigedon.sh directly.
# SIGEDON_RESTORE_DRILL_ENABLED=YES
# SIGEDON_RESTORE_CONFIRM=YES
# SIGEDON_RESTORE_DB=test_restore_sigedon_drill
# SIGEDON_RESTORE_MEDIA_ROOT=/var/tmp/sigedon_restore_drill_media
# SIGEDON_RESTORE_ALLOWED_PREFIXES=test_restore_|staging_restore_
# SIGEDON_RESTORE_DRILL_RUN_DJANGO=NO
