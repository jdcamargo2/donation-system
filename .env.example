# Desarrollo local (SQLite explícito)
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DATABASE_ENGINE=sqlite
ALLOWED_HOSTS=localhost,127.0.0.1
# Opcional en desarrollo: override absoluto del media privado.
# Sin valor, Django usa <BASE_DIR>/media.
# SIGEDON_MEDIA_ROOT=

# Solo desarrollo: contraseña para usuarios creados por seed_sigedon_demo.
# Nunca usar en producción. El comando está deshabilitado cuando DJANGO_DEBUG=False
# y nunca imprime este valor.
# SIGEDON_DEMO_PASSWORD=

# Gunicorn runtime (producción; ver deploy/gunicorn.conf.py y docs/DEPLOYMENT.md)
# PORT=8000
# GUNICORN_BIND=                 # si se define, sustituye 0.0.0.0:$PORT
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=1
# GUNICORN_TIMEOUT=60
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_KEEPALIVE=5
# GUNICORN_LOG_LEVEL=info
# GUNICORN_ACCESS_LOG=-
# GUNICORN_ERROR_LOG=-
#
# Render (runtime Python nativo; sin Docker en el despliegue inicial):
#   Build:     ./deploy/render/build.sh
#   Pre-deploy:./deploy/render/pre_deploy.sh  (owner one-off; ver runbook)
#   Start:     ./deploy/start_web.sh
#   Health:    /readyz/
#   Post-deploy (runtime): ./deploy/render/post_deploy_verify.sh
#   Registro:  docs/runbooks/RENDER_ENVIRONMENT.md
#   Primer deploy: docs/runbooks/RENDER_FIRST_DEPLOY.md
# Migraciones: nunca en build ni en Gunicorn. R2 deshabilitado hasta probe real.
# No hay servicio Render/R2/dominio provisionados en este checkpoint.
# WhiteNoise sirve STATIC_ROOT. Media privada final en Render: R2 (no filesystem).

# Runtime logging (stdout/stderr; ver docs/OPERATIONS.md y docs/DEPLOYMENT.md)
# DJANGO_LOG_LEVEL=INFO
# SIGEDON_LOG_LEVEL=INFO
# KOBO_LOG_LEVEL=INFO

# Producción (PostgreSQL obligatorio; sustituir todos los placeholders)
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=replace-with-a-long-random-value
# ALLOWED_HOSTS=sigedon.example.org
# DATABASE_ENGINE=postgresql
# POSTGRES_DB=sigedon
#
# Separación de roles PostgreSQL (ver deploy/postgresql/harden_runtime_role.sql
# y docs/DEPLOYMENT.md):
#   - Al ejecutar `python manage.py migrate`, usar temporalmente las
#     credenciales de sigedon_owner (propietario/migraciones).
#   - Para runtime (web, workers, comandos ordinarios), usar sigedon_app.
#   - Nunca usar "postgres" como usuario runtime en producción.
# POSTGRES_USER=sigedon_app
# POSTGRES_PASSWORD=replace-with-a-strong-password
# POSTGRES_HOST=db.example.internal
# POSTGRES_PORT=5432
# DATABASE_CONN_MAX_AGE=60
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# SECURE_PROXY_SSL_HEADER_ENABLED=False
#
# Absolute path to a persistent private-media volume in production.
# Required when DJANGO_DEBUG=False and SIGEDON_PRIVATE_STORAGE=filesystem.
# - Not publicly served (only protected preview/download endpoints).
# - Must survive app restarts/redeploys/instance replacement.
# - Must be included in backups (same value as backup SIGEDON_MEDIA_ROOT).
# - Must be writable by the application process.
# - Provision/mount the directory before startup; Django does not create it.
# SIGEDON_MEDIA_ROOT=/var/lib/sigedon/media

# Private storage backend (default filesystem). Presence of R2_* alone
# never selects R2 — set SIGEDON_PRIVATE_STORAGE=r2 explicitly.
# R2 is prepared in code but not provisioned (no Cloudflare account/bucket yet).
# SIGEDON_PRIVATE_STORAGE=filesystem
# SIGEDON_PRIVATE_FILE_DELIVERY=stream
# # delivery: stream | signed_redirect
# Cloudflare R2 (placeholders only — no real credentials in this file).
# Bucket must stay private: do not enable r2.dev / public development URL.
# Required when SIGEDON_PRIVATE_STORAGE=r2:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=                 # optional; else derived from R2_ACCOUNT_ID
# R2_REGION_NAME=auto
# R2_SIGNED_URL_EXPIRY_SECONDS=300 # 60–900
# R2_ADDRESSING_STYLE=path
# Forbidden / rejected if set: R2_PUBLIC_URL, AWS_S3_CUSTOM_DOMAIN, …

# Backup / restore / automation (deploy/backups/). Los scripts NO leen este
# archivo; exportar en la sesion del operador o en el EnvironmentFile del
# scheduler. Preferir ~/.pgpass antes que PGPASSWORD. Sin valores productivos.
# SIGEDON_BACKUP_ROOT=/var/backups/sigedon
#   (si no existe, backup_sigedon.sh lo crea con permisos 0700)
# SIGEDON_MEDIA_ROOT=/var/lib/sigedon/media
#   (modo filesystem: debe coincidir con Django; debe existir; el script no lo
#    crea. Modo r2: no se exige para empaquetar media.tar.gz; objects/ sale de
#    export_private_objects)
# SIGEDON_PRIVATE_STORAGE=filesystem
# SIGEDON_MAINTENANCE_CONFIRMED=YES
# SIGEDON_BACKUP_KEEP_COUNT=7
# SIGEDON_BACKUP_KEEP_DAYS=30
# SIGEDON_BACKUP_ALERT_HOOK=/usr/local/sbin/sigedon-backup-alert.sh
# SIGEDON_BACKUP_ALERT_HOOK_TIMEOUT_SECONDS=30
# SIGEDON_BACKUP_ALERT_ON_SUCCESS=NO
# PGPASSWORD=   # opcional; preferir ~/.pgpass
# SIGEDON_RESTORE_DB=test_restore_sigedon_YYYYMMDD
# SIGEDON_RESTORE_MEDIA_ROOT=/var/tmp/sigedon_restore_media
# SIGEDON_RESTORE_CONFIRM=YES
# SIGEDON_RESTORE_ALLOWED_PREFIXES=test_restore_|staging_restore_
# SIGEDON_RESTORE_DRILL_ENABLED=YES
# SIGEDON_RESTORE_DRILL_RUN_DJANGO=NO
# Ejemplos de scheduler: deploy/backups/examples/

# KoboToolbox
KOBO_ENABLED=False
KOBO_BASE_URL=
KOBO_API_TOKEN=
KOBO_WEBHOOK_USERNAME=sigedon-kobo
KOBO_WEBHOOK_SECRET=
KOBO_FICHA_01_ASSET_UID=
KOBO_HTTP_CONNECT_TIMEOUT=5
KOBO_HTTP_READ_TIMEOUT=15
KOBO_HTTP_MAX_ATTEMPTS=3
KOBO_HTTP_RETRY_BASE_DELAY=0.5
KOBO_HTTP_RETRY_MAX_DELAY=8
KOBO_HTTP_RETRY_AFTER_MAX_DELAY=60
KOBO_HTTP_MAX_PAGES=100
KOBO_SYNC_OVERLAP_SECONDS=300
KOBO_SYNC_LEASE_SECONDS=900
KOBO_MAX_ATTACHMENT_BYTES=10485760
KOBO_ATTACHMENT_PROCESSING_TIMEOUT_SECONDS=900
KOBO_WEBHOOK_MAX_BYTES=1048576
