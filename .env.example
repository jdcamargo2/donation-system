# SIGEDON — Local Demo
# Arranque local recomendado. Catálogo de producción/Kobo/R2/backups:
#   docs/runbooks/RENDER_ENVIRONMENT.md
#   docs/KOBO.md
#   docs/runbooks/CLOUDFLARE_R2.md
#   deploy/backups/README.md
#   docs/DEPLOYMENT.md
#   docs/OPERATIONS.md

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (ruta principal y recomendada)
DATABASE_ENGINE=postgresql
POSTGRES_DB=db_sigedon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Demo (solo DEBUG=True; nunca documentar un valor real)
SIGEDON_DEMO_PASSWORD=

# Private storage (filesystem local)
SIGEDON_PRIVATE_STORAGE=filesystem
SIGEDON_MAX_PRIVATE_UPLOAD_BYTES=10485760

# KoboToolbox — desconectado por defecto (hub showcase sintético)
KOBO_ENABLED=False

# Para activar la integración live (requiere instancia y credenciales externas):
# KOBO_ENABLED=True
# KOBO_BASE_URL=
# KOBO_API_TOKEN=
# KOBO_WEBHOOK_USERNAME=sigedon-kobo
# KOBO_WEBHOOK_SECRET=
# Detalle de knobs HTTP/sync/adjuntos: docs/KOBO.md
