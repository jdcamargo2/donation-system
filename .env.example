# Desarrollo local (SQLite explícito)
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DATABASE_ENGINE=sqlite
ALLOWED_HOSTS=localhost,127.0.0.1

# Producción (PostgreSQL obligatorio; sustituir todos los placeholders)
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=replace-with-a-long-random-value
# ALLOWED_HOSTS=sigedon.example.org
# DATABASE_ENGINE=postgresql
# POSTGRES_DB=sigedon
#
# Separación de roles PostgreSQL (ver deploy/postgresql/harden_runtime_role.sql
# y docs/DEPLOYMENT.md):
#   - Al ejecutar `python manage.py migrate`, usar temporalmente las
#     credenciales de sigedon_owner (propietario/migraciones).
#   - Para runtime (web, workers, comandos ordinarios), usar sigedon_app.
#   - Nunca usar "postgres" como usuario runtime en producción.
# POSTGRES_USER=sigedon_app
# POSTGRES_PASSWORD=replace-with-a-strong-password
# POSTGRES_HOST=db.example.internal
# POSTGRES_PORT=5432
# DATABASE_CONN_MAX_AGE=60
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# SECURE_PROXY_SSL_HEADER_ENABLED=False

# KoboToolbox
KOBO_ENABLED=False
KOBO_BASE_URL=
KOBO_API_TOKEN=
KOBO_WEBHOOK_USERNAME=sigedon-kobo
KOBO_WEBHOOK_SECRET=
KOBO_FICHA_01_ASSET_UID=
KOBO_REQUEST_TIMEOUT_SECONDS=15
KOBO_MAX_ATTACHMENT_BYTES=10485760
KOBO_ATTACHMENT_PROCESSING_TIMEOUT_SECONDS=900
KOBO_WEBHOOK_MAX_BYTES=1048576
